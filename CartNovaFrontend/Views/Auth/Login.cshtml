@model LoginDto

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white text-center py-3">
                <h3 class="mb-0">
                    <i class="bi bi-box-arrow-in-right me-2"></i>
                    Login
                </h3>
            </div>

            <div class="card-body p-4">
                <form asp-action="Login" asp-controller="Auth" method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email"
                               class="form-control"
                               placeholder="Enter your email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               placeholder="Enter your password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" id="submitBtn" class="btn btn-primary"> <span id="btnText">Login</span> <span id="spinner" class="spinner-border spinner-border-sm d-none"></span> </button>
                    </div>

                    <div class="text-center mt-3">
                        <small class="text-muted">
                            Don't have an account?
                            <a asp-action="Register"
                               asp-controller="Auth"
                               class="text-decoration-none">
                                Register here
                            </a>
                        </small>
                    </div>

                </form>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
